{
  "$ref": "#/definitions/cms.platform-instruments",
  "definitions": {
    "cms.platform-instruments": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:-]{1,64}$"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "trade",
                  "closeOnly"
                ]
              }
            },
            "required": [
              "symbol",
              "mode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "updatedAt",
        "instruments"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
