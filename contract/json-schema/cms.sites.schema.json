{
  "$ref": "#/definitions/cms.sites",
  "definitions": {
    "cms.sites": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$"
        },
        "name": {
          "type": "string"
        },
        "demoStartBalanceCents": {
          "type": "number",
          "minimum": 0
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ru",
              "en",
              "de",
              "fr",
              "es"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "defaultLanguage": {
          "type": "string",
          "enum": [
            "ru",
            "en",
            "de",
            "fr",
            "es"
          ]
        }
      },
      "required": [
        "slug",
        "name",
        "demoStartBalanceCents",
        "instruments"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}