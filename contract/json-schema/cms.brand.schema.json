{
  "$ref": "#/definitions/cms.brand",
  "definitions": {
    "cms.brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "alt": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "width",
                "height",
                "alt",
                "mimeType"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "favicon": {
          "anyOf": [
            {
              "$ref": "#/definitions/cms.brand/properties/logo/anyOf/0"
            },
            {
              "type": "null"
            }
          ]
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "heroBackground": {
          "type": "string",
          "enum": [
            "quotes",
            "off"
          ]
        },
        "logoMode": {
          "type": "string",
          "enum": [
            "logo-name",
            "logo",
            "name"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ru",
              "en",
              "de",
              "fr",
              "es"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "defaultLanguage": {
          "type": "string",
          "enum": [
            "ru",
            "en",
            "de",
            "fr",
            "es"
          ]
        },
        "legalEntity": {
          "type": "object",
          "properties": {
            "name": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "registrationNumber": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "licenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "activity": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "regulator": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "regulatorCountry": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "verifyUrl": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "document": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "filename": {
                            "type": "string"
                          },
                          "mimeType": {
                            "type": "string",
                            "const": "application/pdf"
                          }
                        },
                        "required": [
                          "url",
                          "filename",
                          "mimeType"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "number",
                  "activity",
                  "regulator",
                  "regulatorCountry",
                  "verifyUrl",
                  "document"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "name",
            "registrationNumber",
            "address",
            "licenses"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "logo",
        "favicon",
        "primaryColor",
        "socials"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
