{
  "name": "broker-cms",
  "version": "0.1.0",
  "description": "Standalone CMS service (Payload 3) for the broker platform. Serves content via the platform contract /v1/cms/*.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "typecheck": "tsc --noEmit",
    "i18n:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/i18n/import-translations.ts --",
    "test:i18n": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/i18n/test-i18n.ts",
    "test:migration": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/i18n/test-migration.ts",
    "test:redeploy": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-redeploy.ts",
    "test:live-params": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-live-params.ts",
    "test:platform-instruments": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-platform-instruments.ts",
    "test:video-links": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-video-links.ts",
    "test:articles": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-articles.ts",
    "test:instrument-catalog": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-instrument-catalog.ts",
    "test:legal-entity": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-legal-entity.ts",
    "test:system-status": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-system-status.ts",
    "test": "pnpm test:live-params && pnpm test:instrument-catalog && pnpm test:legal-entity"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.9.0",
    "next": "15.4.11",
    "payload": "3.86.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
